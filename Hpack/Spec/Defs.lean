  The definitions the statements in `Hpack/Spec.lean` use, written from
  RFC 7541 (HPACK: Header Compression for HTTP/2),
  https://www.rfc-editor.org/rfc/rfc7541.

  This file is part of the specification: a reviewer approves it with
  `Hpack/Spec.lean`. It imports nothing and shares nothing with the code in
  `Hpack/`. The tables below copy Appendix A and the "code as bits"
  column of Appendix B; the code uses the "code as hex" column instead,
  and a proof checks that the two agree.
-/

namespace Hpack.Spec

/-! ## Integers (section 5.1) -/

/-- The octets of an integer `i` with an `n`-bit prefix, as the
    encoding pseudocode of section 5.1 gives them, before the other bits
    of the first octet are set:

    ```
    if I < 2^N - 1, encode I on N bits
    else
        encode (2^N - 1) on N bits
        I = I - (2^N - 1)
        while I >= 128
             encode (I % 128 + 128) on 8 bits
             I = I / 128
        encode I on 8 bits
    ``` -/
def intOctets (n i : Nat) : List Nat :=
  if i < 2 ^ n - 1 then [i] else (2 ^ n - 1) :: rest (i - (2 ^ n - 1))
where
  /-- The `while` loop and the last line. -/
  rest (i : Nat) : List Nat :=
    if i ≥ 128 then (i % 128 + 128) :: rest (i / 128) else [i]
  termination_by i
  decreasing_by omega

/-- The encoding of `i` with an `n`-bit prefix, with `high` in the
    `8 - n` bits of the first octet that the prefix leaves (for a string
    length, `high` is the H flag). -/
def intEncode (n high i : Nat) : List UInt8 :=
  match intOctets n i with
  | [] => []
  | o :: os => (high * 2 ^ n + o).toUInt8 :: os.map Nat.toUInt8

/-- The decoding pseudocode of section 5.1, which reads the first `n`
    bits as the prefix and ignores the others:

    ```
    decode I from the next N bits
    if I < 2^N - 1, return I
    else
        M = 0
        repeat
            B = next octet
            I = I + (B & 127) * 2^M
            M = M + 7
        while B & 128 == 128
        return I
    ```
    It gives the value and the octets after it, or `none` when the input
    ends first. -/
def intDecode (n : Nat) : List UInt8 → Option (Nat × List UInt8)
  | [] => none
  | b :: bs =>
    let i := b.toNat % 2 ^ n
    if i < 2 ^ n - 1 then some (i, bs) else loop bs i 0
where
  /-- The `repeat` loop. -/
  loop : List UInt8 → Nat → Nat → Option (Nat × List UInt8)
    | [], _, _ => none
    | b :: bs, i, m =>
      let i := i + (b.toNat % 128) * 2 ^ m
      if b.toNat / 128 = 1 then loop bs i (m + 7) else some (i, bs)

