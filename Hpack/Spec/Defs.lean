/-- `len` bits of `v`, most significant first. -/
def bitsOf (v len : Nat) : List Bool :=
  (List.range len).reverse.map fun k => v / 2 ^ k % 2 == 1

/-- The code of a symbol as a list of bits, most significant first. -/
def code (sym : Nat) : List Bool :=
  match huffmanCodes[sym]? with
  | some (v, len) => bitsOf v len
  | none => []

/-- The bits of an octet, most significant first. -/
def octetBits (b : UInt8) : List Bool :=
  [7, 6, 5, 4, 3, 2, 1, 0].map fun k => b.toNat / 2 ^ k % 2 = 1

/-- The bits of a list of octets, in order. -/
def bits (d : List UInt8) : List Bool := d.flatMap octetBits

/-- `d` is the Huffman encoding of the octets `s`, as section 5.2 says:
    "the bitwise concatenation of the codes corresponding to each octet
    of the string literal", followed by padding to the next octet
    boundary made of "the most significant bits of the code
    corresponding to the EOS (end-of-string) symbol". That code is 30
    ones, and padding is at most 7 bits, so the padding is up to 7 ones.

    This is also what a decoder must accept and nothing else: "A padding
    strictly longer than 7 bits MUST be treated as a decoding error. A
    padding not corresponding to the most significant bits of the code
    for the EOS symbol MUST be treated as a decoding error. A
    Huffman-encoded string literal containing the EOS symbol MUST be
    treated as a decoding error." -/
def HuffmanEncodes (s d : List UInt8) : Prop :=
  ∃ k, k < 8 ∧ bits d = s.flatMap (fun c => code c.toNat) ++ List.replicate k true

/-! ## String literals (section 5.2) -/

/-- `b` is a string literal for the octets `s`: the H flag, the length
    of the string data as an integer with a 7-bit prefix, in the fewest
    octets as `intEncode` writes it, and the string data. With H = 0 the data is `s` itself; with H = 1 it is the Huffman
    encoding of `s`. -/
def StringLiteral (huffman : Bool) (s b : List UInt8) : Prop :=
  if huffman then ∃ d, HuffmanEncodes s d ∧ b = intEncode 7 1 d.length ++ d
  else b = intEncode 7 0 s.length ++ s

/-- The octets of a string of ASCII characters, for writing examples. -/
def ascii (s : String) : List UInt8 := s.toList.map fun c => c.toNat.toUInt8

